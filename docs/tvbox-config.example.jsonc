// ============================================================================
// TVBox-n2n 远程配置接口 · 参考配置文件（带中文注释与用法）
// ----------------------------------------------------------------------------
// 本文件为「带注释版」参考，方便阅读与修改；
//   · 直接部署时请使用去掉注释的 docs/tvbox-config.example.json（标准 JSON）。
//   · 若服务器支持 JSONC（如部分静态托管/CDN），也可直接使用本文件。
//
// 【用法】
//   1. 把本文件内容（去掉 // 注释后）保存为一份 UTF-8 编码的 .json 文件；
//   2. 上传到你自己的 HTTP(S) 静态托管地址，例如 GitHub Pages / 对象存储 / Nginx；
//      务必保证接口可通过 GET 访问且返回 200（可用的直链，不要带下载跳转）。
//      接口地址支持 http:// 与 https://（未写协议时会自动补 http://）。
//   3. 打开 TVBox →「设置」→「设置其他」页面；
//   4. 在顶部「配置地址」下方的「远程配置」卡片里，点击「配置接口」；
//      填入第 2 步得到的 JSON 地址并确定，App 会立即拉取一次；
//   5. 之后 App 会按「checkInterval」设定的间隔（默认 30 分钟）定时拉取刷新，
//      每次进入首页也会自动拉取（5 分钟内不重复请求）；
//      想手动刷新时，点「同步配置」即可立即拉取。
//
// 【覆盖规则】
//   · notice / notice 样式 / home 外观 / tkp2p / theme / themes / entries / hin2nEntry /
//     hin2nUrl / apkUrl / checkInterval / ua：每次拉取成功都覆盖为新值；
//   · api / live / epg / proxy（点播/直播/EPG/代理地址）：仅当你「尚未在 tvbox 内配置」
//     （当前值为空）时才作为默认值写入；一旦你在 tvbox 设置里配置过某个接口，
//     JSON 即不再覆盖该接口（四个接口互不影响，可只交给 JSON 管其中几个）；
//   · version：日期版本号（yyyyMMdd），大于 App 内置本地配置版本号且 apkUrl 有效时，
//     自动在 TVBox 内下载新 APK 并拉起安装（每个版本只自动触发一次）；
//   · bootStart：仅作为「默认值」写入一次，之后以用户在界面上的开关为准，
//     重复拉取不会把用户手动改过的值改回去。
//   · 所有字段均为可选：接口里没写或值为空的字段，保持 App 本地现状不变。
//
// 【本地兜底】
//   · App 启动即拉取本接口；若接口未配置或无法访问，会自动读取内置的
//     assets/tvbox-config.json 作为兜底配置（内容格式与本文件一致，默认全部为空）。
//
// 【校验提示】
//   · 根节点必须是 JSON 对象 {}，不能是数组；
//   · 每个 entry 的 pkg 必填（为空则该项被忽略），name/icon/url 可选；
//   · 拉取失败（超时 8 秒、非 200、非法 JSON）不会清空旧配置，界面会提示「同步失败」。
// ============================================================================
{
  // ==================== 公告 ====================
  // notice 支持两种写法：
  //   ① 简单字符串（旧格式）："notice": "公告文本" —— 样式用 App 内置默认值；
  //   ② 对象（新格式，推荐）：可完全自定义样式与显示策略，见下。
  "notice": {
    "text": "欢迎使用 TVBox：本通知由远程 JSON 接口下发，修改接口内容即可全网更新。",

    // 显示位置："bottom"（底部，默认）或 "top"（顶部）
    "position": "bottom",

    // 背景颜色，#RRGGBB 或 #AARRGGBB；留空保持默认半透明黑
    "bgColor": "#66000000",

    // 字体颜色；留空保持默认 #FFFFD54F
    "fontColor": "#FFFFD54F",

    // 字体大小（sp 单位）；留空或 0 保持默认
    "fontSize": 18,

    // 整体透明度 0-100（100 不透明）；留空保持不透明
    "alpha": 100,

    // 自动消失：公告显示多少秒后自动隐藏（秒）；0 或留空 = 一直显示。
    // 定时拉取刷新公告时会重新计时。
    "duration": 0,

    // 显示时间段 "HH:mm"：只在时间段内显示，超出自动隐藏；可跨零点（如 22:00-06:00）。
    // 两个都填才生效；留空则全天显示。
    "timeStart": "00:00",
    "timeEnd": "23:59",

    // 过期时间 "yyyy-MM-dd"：超过该日期（含当天整天）不再显示；留空不过期。
    "expire": "2027-12-31",

    // 滚动速度（像素/秒）：>0 使用自定义平滑滚动（由右向左、背景固定、只有文本滚动）；
    // 0 或留空使用系统 marquee 滚动。
    "speed": 60,

    // 是否在指定界面显示公告（不写默认首页/直播/点播三个界面均显示）。
    // 首页 / 直播播放页 / 点播页可分别开关；也可用 showOnHome / showOnLive / showOnVod。
    "show": {
      "home": true,
      "live": true,
      "vod": true
    }
  },

  // ==================== 首页外观 ====================
  // 下发后立即生效，定时拉取到新值也会实时刷新界面。
  "home": {
    // 背景图片 URL（jpg/png/webp 均可）；留空保持 App 原有背景。
    // 该背景在 App「所有页面」生效（首页/点播/直播/设置等），不仅限于首页。
    "bgImage": "https://example.com/bg.jpg",

    // 顶栏入口图标的背景颜色（wifi/搜索/风格/抽屉/n2n/hin2n/自定义入口全部生效）；
    // 留空保持默认描边背景。支持 #RRGGBB / #AARRGGBB。
    "entryBgColor": "#33FFFFFF",

    // 入口图标着色（单色模板）；留空保持图标原色。
    "iconColor": "",

    // 顶栏文字颜色（App 名称与时间）；留空保持默认白色。
    "textColor": "#FFFFFFFF",

    // 入口整体透明度 0-100；留空保持不透明。
    "alpha": 100,

    // 输入框和按钮的背景颜色（设置页等通用控件底色）；留空保持默认。
    "inputBgColor": "#26FFFFFF",
    "buttonBgColor": "#334FC3F7"
  },

  // ==================== tkp2p:// 播放配置 ====================
  // 直播源中「tkp2p://」前缀的地址会用内置 P2P 播放页播放
  // （p2p-media-loader 负责 HLS 类直播、media-p2p-engine 负责 MP4 等 WebRTC 链路）。
  "tkp2p": {
    // 引擎选择："auto"（按地址自动：.m3u8 走 p2p-media-loader，其余走 media-p2p-engine，
    //           失败自动回退普通播放）、"hls"（强制 p2p-media-loader）、"media"（强制 media-p2p-engine）
    "engine": "auto",

    // p2p-media-loader 的 WebRTC tracker 列表（wss:// 开头），可多个
    "announce": [
      "wss://tracker.openwebtorrent.com",
      "wss://tracker.webtorrent.dev"
    ],

    // media-p2p-engine（SwarmCloud）的 token（官方申请）；留空用试用 token
    "token": "",

    // SwarmCloud tracker 区域：eu / hk / us / cn
    "zone": "cn",

    // 自定义 ICE/STUN 服务器（JSON 数组，标准 iceServers 格式）；留空用内置默认
    "ice": []
  },

  // ==================== 主题一键切换 ====================
  // 首页顶栏的调色板图标可一键循环切换主题，切换后立即生效。
  // 此处可下发默认主题；支持 索引（0 起）/ 中文名 / 英文别名。
  // 中文名：红色 蓝色 深蓝 橙色 黄色 品红 粉色 翠绿 青色 紫色 琥珀 靛蓝 玫红 石墨
  // 英文别名：red blue darkblue orange yellow magenta pink emerald teal violet amber indigo rose graphite
  "theme": "violet",

  // ==================== 主题清单（覆盖内置主题 / 新建自定义主题） ====================
  // 14 个内置主题的完整配色已内置在 assets/tvbox-config.json 的 themes 中，
  // 远程接口可下发同名数组进行覆盖或追加；落盘后重启依然生效。
  // 每项字段：
  //   style  ：内置主题序号 0..13（见上面别名顺序）。填了表示「覆盖该内置主题」；
  //            不写 style 表示「追加一个自定义主题」（可在调色板里循环到）。
  //   name   ：主题显示名（覆盖时也可用 alias 定位而不改名字）
  //   alias  ：英文别名（主题切换/去重定位用，自定义主题建议填，全小写）
  //   color  ：主色 #RRGGBB（按钮/标题/代码取色用，自定义主题以此色为准）
  //   dark   ：深色基色（暗色描边/渐变辅助）
  //   bgStart/bgEnd：全局渐变背景的深/浅两端颜色
  // 说明：受 Android 机制限制，drawable 里的 ?attr/color_theme 只能套用最近的内置
  //       XML 主题配色，自定义主题会自动匹配 RGB 距离最近的内置样式。
  "themes": [
    // 例 1：覆盖 0 号「红色」主题，换成自定义红色
    { "name": "红色", "alias": "red", "style": 0,
      "color": "#FF2A2A", "dark": "#8C1418", "bgStart": "#3D0A0D", "bgEnd": "#FF2A2A" },
    // 例 2：追加一个全新的自定义主题「薄荷」（不写 style）
    { "name": "薄荷", "alias": "mint",
      "color": "#3DDC97", "dark": "#1E7A55", "bgStart": "#0B2E22", "bgEnd": "#3DDC97" }
  ],

  // ==================== 点播 / 直播 / EPG / 代理地址 ====================
  // 默认从本 JSON 读取：当你未在 tvbox 设置里配置对应接口（当前值为空）时，
  // 自动采用这里的地址；一旦你在 tvbox 内配置过某个接口，该接口即不再被 JSON 覆盖。
  // 修改这些地址后需重启 App 生效。留空表示 JSON 不接管该接口。
  "api": "",      // 点播接口地址
  "live": "",     // 直播接口地址（支持 txt / json 格式）
  "epg": "",      // EPG 接口地址
  "proxy": "",    // 代理地址

  // ==================== 日期版本检查 + APK 自动更新 ====================
  // version 为「日期版本号」，取前 8 位数字按 yyyyMMdd 比较：
  //   支持 "20261015"、"2026-10-15"、"20261015_1200"、"1.0.20261015" 等写法。
  // 当远程 version 日期「大于」App 内置本地配置（assets/tvbox-config.json）的版本日期，
  // 且 apkUrl 为有效 APK 直链时，App 自动后台下载 APK 并拉起系统安装界面，
  // 每个新版本只自动触发一次（安装确认仍需用户在系统弹窗点击）。
  // 本地兜底配置不会触发自动更新；apkUrl 留空则只记录版本不下载。
  "version": "20261015",
  "apkUrl": "https://github.com/tianku1985/tvbox-n2n/releases/latest/download/TVBox.apk",

  // ==================== 定时检查 ====================
  // App 每隔多少分钟自动拉取一次本 JSON 接口并刷新公告/入口/外观；
  // 最小 1 分钟，默认 30。留空或非法值按默认处理。
  "checkInterval": 30,

  // ==================== 全局 UA ====================
  // 拉取本远程配置接口、以及网页型直播（webview:// / video:// / tkp2p://）的
  // WebView 均使用该 User-Agent；留空使用 App 内置浏览器 UA。
  "ua": "",

  // 「开机启动」开关的默认值：
  //   true  = 默认开启（App 安装/首次拉取后自动写入一次）
  //   false = 默认关闭
  // 注意：只在远端还没写过默认值时生效一次，用户在设置界面手动改过后不再被覆盖。
  "bootStart": true,

  // 首页是否显示固定的「hin2n」入口图标（true/false）。
  // 关闭后首页不显示 hin2n 图标，但不影响 entries 里的自定义入口。
  "hin2nEntry": true,

  // hin2n 未安装时使用的 APK 下载地址（HTTP(S) 直链）。
  // 确认安装后 TVBox 会在后台直接下载 APK（带进度提示），完成后自动拉起系统安装界面；
  // Android 8+ 首次会先引导开启「允许安装未知应用」。
  // 留空则提示「请在远程配置接口中补充下载地址」。
  "hin2nUrl": "https://github.com/tianku1985/tvbox-n2n/releases/latest/download/hin2n.apk",

  // 首页自定义入口列表（可放多个 App 快捷图标）。
  // 每项字段说明：
  //   name ：入口显示名称（中文/英文均可）
  //   pkg  ：目标 App 的 Android 包名，必填；为空则该入口被忽略
  //   icon ：入口图标 URL（可选，留空则用默认图标）
  //   url  ：未安装「pkg」对应 App 时后台下载安装用的 APK 直链（可选）
  // 行为：点击入口 → 若已安装则直接拉起该 App；
  //       若未安装则弹窗确认后由 TVBox 后台下载 APK 并拉起安装（不跳浏览器）。
  "entries": [
    {
      "name": "hin2n",
      "pkg": "wang.switchy.hin2n",
      "icon": "https://raw.githubusercontent.com/tianku1985/tvbox-n2n/main/docs/icons/hin2n.png",
      "url": "https://github.com/tianku1985/tvbox-n2n/releases/latest/download/hin2n.apk"
    },
    {
      "name": "文件管理",
      "pkg": "com.android.documentsui",
      "icon": "",
      "url": ""
    }
  ]
}
