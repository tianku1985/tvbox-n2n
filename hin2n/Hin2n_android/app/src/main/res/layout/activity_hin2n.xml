<?xml version="1.0" encoding="utf-8"?>
<!-- hin2n TV 引导页：连接控制 / 当前配置 / 开机启动 / Ping / 日志，遥控器可操控 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hin2n_bg"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_40"
    android:paddingRight="@dimen/vs_40"
    android:paddingTop="@dimen/vs_30"
    android:paddingBottom="@dimen/vs_30">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="组网"
        android:textColor="@color/color_FFFFFF_90"
        android:textSize="@dimen/ts_40"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHin2nStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:text="状态：未连接"
        android:textColor="@color/color_FFFFFF_90"
        android:textSize="@dimen/ts_28" />

    <TextView
        android:id="@+id/btnHin2nConnect"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_100"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/button_hin2n_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="连接"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_32" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnHin2nList"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_80"
            android:layout_weight="1"
            android:background="@drawable/shape_hin2n_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="配置管理"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/btnHin2nAdd"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_80"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:background="@drawable/shape_hin2n_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="新建配置"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/btnHin2nPing"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_80"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:background="@drawable/shape_hin2n_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Ping 测试"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnHin2nBoot"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_80"
            android:layout_weight="1"
            android:background="@drawable/shape_hin2n_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="开机启动：关"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/btnHin2nClearLog"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_80"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:background="@drawable/shape_hin2n_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="清空日志"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/btnHin2nCopyLog"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_80"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:background="@drawable/shape_hin2n_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="复制日志"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/btnHin2nBack"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_80"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:background="@drawable/shape_hin2n_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="返回"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHin2nCurrent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_20"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="当前配置：无"
        android:textColor="@color/color_FFFFFF_50"
        android:textSize="@dimen/ts_22" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_15"
        android:text="运行日志"
        android:textColor="@color/color_FFFFFF_90"
        android:textSize="@dimen/ts_22" />

    <ScrollView
        android:id="@+id/svHin2nLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_10"
        android:layout_weight="1"
        android:background="@drawable/shape_hin2n_log"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvHin2nLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/vs_20"
            android:fontFamily="monospace"
            android:text="日志加载中..."
            android:textColor="#CCFFFFFF"
            android:textIsSelectable="true"
            android:textSize="@dimen/ts_18" />
    </ScrollView>

</LinearLayout>
