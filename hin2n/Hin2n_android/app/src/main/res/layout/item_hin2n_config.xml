<?xml version="1.0" encoding="utf-8"?>
<!-- hin2n 配置列表行：名称区可聚焦点击即切换；右侧 编辑/复制/删除 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/vs_15"
    android:background="@drawable/shape_hin2n_button"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_30"
    android:paddingRight="@dimen/vs_15"
    android:paddingTop="@dimen/vs_15"
    android:paddingBottom="@dimen/vs_15">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHin2nItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="配置名"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_28" />

        <TextView
            android:id="@+id/tvHin2nItemDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_5"
            android:singleLine="true"
            android:text="supernode"
            android:textColor="#CCFFFFFF"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHin2nItemSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/vs_15"
        android:text="当前"
        android:textColor="#FFFFD54F"
        android:textSize="@dimen/ts_20"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnHin2nItemEdit"
        android:layout_width="@dimen/vs_100"
        android:layout_height="@dimen/vs_60"
        android:gravity="center"
        android:text="编辑"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_20" />

    <TextView
        android:id="@+id/btnHin2nItemCopy"
        android:layout_width="@dimen/vs_100"
        android:layout_height="@dimen/vs_60"
        android:gravity="center"
        android:text="复制"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ts_20" />

    <TextView
        android:id="@+id/btnHin2nItemDelete"
        android:layout_width="@dimen/vs_100"
        android:layout_height="@dimen/vs_60"
        android:gravity="center"
        android:text="删除"
        android:textColor="#FFFF8A80"
        android:textSize="@dimen/ts_20" />

</LinearLayout>
