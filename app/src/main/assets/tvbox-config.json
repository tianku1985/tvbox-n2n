{
  // ============================ 公告（所有界面可显示，含直播） ============================
  "notice": {
    "text": "",                         // 公告内容，留空不显示
    "position": "bottom",               // 显示位置：top | bottom
    "bgColor": "#B31B1B1B",             // 背景色（含透明度）
    "fontColor": "#FFFFD54F",           // 文字颜色
    "fontSize": 18,                     // 文字大小（sp）
    "alpha": 100,                       // 整条公告透明度 0-100
    "duration": 0,                      // 显示多少秒后自动隐藏，0=一直显示
    "timeStart": "",                    // 每日显示开始时间 "08:00"，空=不限
    "timeEnd": "",                      // 每日显示结束时间 "22:00"
    "expire": "",                       // 过期日期 "2026-12-31"，空=永不过期
    "speed": 60,                        // 滚动速度（像素/秒），默认由右向左
    "show": { "home": true, "live": true, "vod": true }  // 分别控制首页/直播/点播是否显示
  },

  // ============================ 首页外观 ============================
  "home": {
    "bgImage": "",                      // 背景图片 URL，空=用主题渐变背景
    "entryBgColor": "",                 // 入口卡片背景，空=随主题色
    "iconColor": "",                    // 图标颜色，空=白色
    "textColor": "",                    // 文字颜色，空=白色
    "alpha": 100,                       // 入口卡片透明度 0-100
    "inputBgColor": "",                 // 输入框背景，空=主题半透明色
    "buttonBgColor": ""                 // 按钮背景，空=主题半透明色
  },

  // ============================ tkp2p:// 原生 P2P 播放 ============================
  "tkp2p": {
    "engine": "auto",                   // auto | p2p-media-loader | media-p2p-engine
    "announce": [],                     // tracker 地址列表
    "token": "",                        // P2P 服务 token
    "zone": "cn",                       // 区域
    "ice": []                           // 自定义 ICE servers
  },

  // ============================ 主题 ============================
  // 启动默认主题：可填 themes 中的 style 数字、中文名或英文 alias；空=不强制
  // 每个主题除颜色外还可配背景图："bgImage": "url"（一张）或 "bgImages": ["url1","url2"]（多张，
  // 多张时随机选一张并在该主题下保持稳定）；配置了背景图则所有页面背景用图，否则用 bgStart/bgEnd 渐变
  "theme": "",
  "themes": [
    { "name": "红色", "alias": "red",      "style": 0,  "color": "#D81F26", "dark": "#8C1418", "bgStart": "#3D0A0D", "bgEnd": "#D81F26" },
    { "name": "蓝色", "alias": "blue",     "style": 1,  "color": "#18A2E7", "dark": "#106D9C", "bgStart": "#0A3D5C", "bgEnd": "#18A2E7" },
    { "name": "深蓝", "alias": "darkblue", "style": 2,  "color": "#004B93", "dark": "#002547", "bgStart": "#001B40", "bgEnd": "#004B93" },
    { "name": "橙色", "alias": "orange",   "style": 3,  "color": "#FF7439", "dark": "#B35127", "bgStart": "#4A2210", "bgEnd": "#FF7439" },
    { "name": "黄色", "alias": "yellow",   "style": 4,  "color": "#FFD55E", "dark": "#B39542", "bgStart": "#4A3D1C", "bgEnd": "#FFD55E" },
    { "name": "品红", "alias": "magenta",  "style": 5,  "color": "#FF2F70", "dark": "#B3204E", "bgStart": "#4A0D22", "bgEnd": "#FF2F70" },
    { "name": "粉色", "alias": "pink",     "style": 6,  "color": "#FD9BDB", "dark": "#B06B98", "bgStart": "#4A3044", "bgEnd": "#FD9BDB" },
    { "name": "翠绿", "alias": "emerald",  "style": 7,  "color": "#00C08B", "dark": "#007A58", "bgStart": "#0A3D2B", "bgEnd": "#00C08B" },
    { "name": "青色", "alias": "teal",     "style": 8,  "color": "#17B9B0", "dark": "#0E7A74", "bgStart": "#0A3D3D", "bgEnd": "#17B9B0" },
    { "name": "紫色", "alias": "violet",   "style": 9,  "color": "#9A6BF2", "dark": "#6747A8", "bgStart": "#3A2760", "bgEnd": "#9A6BF2" },
    { "name": "琥珀", "alias": "amber",    "style": 10, "color": "#F5A524", "dark": "#A86E12", "bgStart": "#4A320B", "bgEnd": "#F5A524" },
    { "name": "靛蓝", "alias": "indigo",   "style": 11, "color": "#5B5BD6", "dark": "#2E2E90", "bgStart": "#222250", "bgEnd": "#5B5BD6" },
    { "name": "玫红", "alias": "rose",     "style": 12, "color": "#E11D48", "dark": "#700E24", "bgStart": "#4A0F1F", "bgEnd": "#E11D48" },
    { "name": "石墨", "alias": "graphite", "style": 13, "color": "#6B7280", "dark": "#3D4250", "bgStart": "#2A2E38", "bgEnd": "#6B7280" }
    // 自定义主题示例（无 style 字段=追加新主题）：可带一张或多张背景图
    // ,{ "name": "夜空", "alias": "night", "color": "#3B82F6", "bgImages": ["https://example.com/bg1.jpg", "https://example.com/bg2.jpg"] }
  ],

  // ============================ 各接口地址 ============================
  // 仅当用户从未在 TVBox 内手动配置过该接口时作为默认值写入一次，手动配置后永不覆盖
  "api": "",                           // 点播源接口
  "live": "",                          // 直播源接口
  "epg": "",                           // 节目单接口
  "proxy": "",                         // 代理地址

  // ============================ 全局 ============================
  "checkInterval": 30,                 // 界面定时刷新间隔（分钟）
  "ua": "",                            // 全局 UA，空=内置浏览器 UA（webview 直播源同样使用）
  "bootStart": false,                  // 开机自动启动 TVBox（在 设置-内置配置 中也可切换）
  "hin2nEntry": true,                  // 首页是否显示「组网」入口

  // ============================ TVBox 远程升级（秒开酒店 IPTV 桌面风格） ============================
  // 启动时检查：远程 versionCode 大于当前版本 → 弹窗提示 → 确认后后台下载 APK
  // （顶部进度条）→ 完成后调起系统安装。每个版本每次启动只提示一次。
  // checkUrl 指向一个返回同结构 json 的地址；不配 checkUrl 时直接使用下方内联字段。
  "upgrade": {
    "checkUrl": "",                    // 远程版本信息地址，如 "https://example.com/tvbox-version.json"
    "versionCode": 0,                  // 内联模式：新版本号（> 当前版本才提示）
    "versionName": "",                 // 新版本名（仅显示用）
    "url": "",                         // 新版 APK 下载地址（必填，否则不提示）
    "force": false,                    // true=强制升级（弹窗无取消按钮）
    "notes": ""                        // 更新内容说明（可空）
  },

  // ============================ hin2n 组网模块（内置模块，无需另装 APK） ============================
  // 仅在应用首次启动（模块数据库为空）时播种一次；之后全部以用户在组网界面内的修改为准。
  // 如需修改出厂配置，改源码本文件后重新编译即可。
  "hin2n": {
    "bootStart": false,                // 开机自动连接 n2n 组网（也可在组网页内切换；与上面的 bootStart 互不影响）
    "staticRoutes": "",                // 静态路由，多条用空格分隔；"CIDR 网关IP" 成对，如 "192.168.8.0/24 10.0.0.13"
    "configs": [
      {
        // ---- 基本配置 ----
        "version": 3,                  // 协议版本：0=n2n_v1, 1=n2n_v2, 2=n2n_v2s, 3=n2n_v3
        "name": "默认组网",             // 配置名称
        "ipMode": 0,                   // IP 分配：0=手动填写 ip；1=由超节点分配（等价 "fromSupernode": true）
        "ip": "10.0.0.6",              // 虚拟 IP（ipMode=0 时必填）
        "netmask": "255.255.255.0",    // 子网掩码
        "community": "mynet",          // 组网名称（community，最长 20 字符）
        "password": "",                // 组网密钥
        "devDesc": "tvbox",            // 设备描述（v2/v3）
        "superNode": "supernode.ntop.org:7777", // 超节点 地址:端口
                                         // 留空时按版本取默认：v1 hin2n.nton.eu.org:10082
                                         // v2 hin2n.nton.eu.org:10086 / v2s :10088 / v3 supernode.ntop.org:7777
        "selected": true,              // 是否作为当前配置（首条默认选中）

        // ---- 高级配置（moreSettings=true 时界面展开；不填按默认） ----
        "moreSettings": true,
        "superNodeBackup": "",         // 备用超节点
        "macAddr": "",                 // 虚拟 MAC，空=随机；格式 "AA:BB:CC:DD:EE:FF"
        "mtu": 1328,                   // MTU，范围 46-1500
        "localIP": "",                 // 本地 IP，"auto" 或留空=自动（等价 "localIpAuto": true，v2s/v3）
        "holePunchInterval": 20,       // 打洞间隔（秒，v2s）
        "resolveSupernodeIp": false,   // 预先解析超节点域名（v1/v2s）
        "localPort": 0,                // 本地端口，0=随机
        "allowRouting": false,         // 允许路由转发（-r）
        "acceptMulticast": false,      // 接受组播/广播（-E，ARP 依赖它，ping 不通对端时尝试打开）
                                         // 也可写反义字段 "dropMulticast": true
        "httpTunnel": false,           // 优先 HTTP 隧道（-H）
        "traceLevel": 2,               // 日志级别：0=错误 1=警告 2=普通 3=信息 4=调试
        "gatewayIp": "",               // 虚拟网关（v2/v3）
        "dnsServer": "",               // DNS 服务器（v2/v3）
        "encryptionMode": "Twofish",   // 加密方式：Twofish | AES-CBC | ChaCha20 | Speck-CTR（v2/v3）
        "headerEnc": false             // 启用包头加密（v2/v3）
      }
      // 需要内置多条配置时继续追加对象即可，例如：
      // ,{ "version": 2, "name": "办公室", "ip": "10.1.0.6",
      //    "community": "office", "superNode": "sn.example.com:5645", "selected": false }
    ]
  },

  // ============================ 首页自定义入口（旧版，仅第三方 App，作用于顶栏） ============================
  // 已安装直接打开；未安装且配置 url 时后台下载 APK（顶部显示进度条），完成后自动调起安装。
  // 顶栏需要更多类型/自定义顺序时请改用下面的 topEntries（配置后 entries 不再生效）
  "entries": [
    // { "name": "文件管理", "pkg": "com.android.filemanager", "icon": "", "url": "" }
  ],

  // ============================ 顶栏入口（topEntries，整体替换内置顶栏图标） ============================
  // 配置后顶栏固定图标（wifi/搜索/单双排/主题/收藏/设置/组网）全部隐藏，内容/顺序/图标完全按本数组。
  // 不配置（删除本字段）则保持内置默认顶栏。元素字段：
  //   name   显示名称（顶栏仅作 contentDescription，历史一行显示在图标右侧）
  //   type   page=打开 TVBox 界面 | feature=内置功能 | app=打开其他 App | vod=自定义点播界面
  //   target type=page   : vod live search fastsearch history collect push setting drive apps hin2n
  //          type=feature: siteSwitch themeSwitch styleSwitch clearCache reloadHome wifi date
  //          type=vod    : 数据接口地址（http(s):// 或 assets/xxx.json 或绝对路径），
  //                        格式与点播 api json 完全一致（取其中 sites），但仅供该新界面，app 其它配置不调用
  //   pkg    type=app 时的包名；未安装且配 url 时后台下载安装（顶部进度条）
  //   icon   http(s) 图片地址或内置 drawable 名（如 hm_search hm_vod hm_live hm_history
  //          hm_fav hm_push hm_folder hm_settings hm_drawer ic_theme ic_hin2n），空=兜底图标
  //   url    type=app 时未安装的 APK 下载地址（可选）
  "topEntries": [
    // { "name": "搜索",   "type": "page",    "target": "search",     "icon": "hm_search" },
    // { "name": "切源",   "type": "feature", "target": "siteSwitch", "icon": "hm_drawer" },
    // { "name": "主题",   "type": "feature", "target": "themeSwitch","icon": "ic_theme" },
    // { "name": "组网",   "type": "page",    "target": "hin2n",      "icon": "ic_hin2n" },
    // { "name": "文件",   "type": "app",     "pkg": "com.android.filemanager", "icon": "", "url": "" },
    // { "name": "我的影院","type": "vod",    "target": "assets/vod-custom.json", "icon": "hm_vod" }
  ],

  // ============================ 首页历史一行入口（homeEntries，整体替换） ============================
  // 配置后首页「历史/点播/直播/搜索/收藏/推送/文件/设置/组网」一行整体替换为本数组，
  // 字段与 topEntries 完全相同；不配置（删除本字段）则保持内置默认一行。
  "homeEntries": [
    // { "name": "历史", "type": "page", "target": "history", "icon": "hm_history" },
    // { "name": "点播", "type": "page", "target": "vod",     "icon": "hm_vod" },
    // { "name": "直播", "type": "page", "target": "live",    "icon": "hm_live" },
    // { "name": "影院", "type": "vod",  "target": "https://example.com/vod.json", "icon": "" }
  ]
}
