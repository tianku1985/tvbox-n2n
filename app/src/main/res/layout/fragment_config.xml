<?xml version="1.0" encoding="utf-8"?>
<!-- 远程配置页布局：开机启动开关 + 配置接口地址 + 立即同步。
     外层 ScrollView 提供纵向滚动。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:id="@+id/ll_cfg_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="30dp"
    android:paddingBottom="30dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="16dp"
        android:text="远程配置"
        android:textColor="#FF00E676"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 开机启动：开机后自动打开本应用（默认值可由远程 JSON 下发） -->
    <LinearLayout
        android:id="@+id/ll_cfg_boot"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_n2n_row"
        android:focusable="true"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="开机启动"
            android:textColor="#FFAAAAAA"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_cfg_boot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:text="关"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:background="#33FFFFFF" />

    <!-- 远程配置接口地址：公告/自定义入口/默认参数均从该 JSON 接口读取 -->
    <LinearLayout
        android:id="@+id/ll_cfg_url"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_n2n_row"
        android:focusable="true"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="配置接口"
            android:textColor="#FFAAAAAA"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_cfg_url"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:text="未设置"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:background="#33FFFFFF" />

    <!-- 立即同步：立刻从配置接口拉取最新公告/入口/默认参数 -->
    <LinearLayout
        android:id="@+id/ll_cfg_sync"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_n2n_row"
        android:focusable="true"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="同步配置"
            android:textColor="#FFAAAAAA"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_cfg_sync"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:text="点击立即同步"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
