<?xml version="1.0" encoding="utf-8"?>
<!-- 与 drawable-v21 版对齐：常态透明（图标背景透明），聚焦/按下用 40% 主题色高亮。
     主题色在 API<21 由 ThemeDrawableFix 运行时替换 18A2E7 为当前主题色 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="#6618A2E7" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="#6618A2E7" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="#6618A2E7" />
	    <!--添加选中外边框-->
	    <stroke android:width="2mm" android:color="@android:color/white" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="false">
        <shape>
            <corners android:radius="@dimen/vs_30" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
